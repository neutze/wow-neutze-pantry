package-as: Neutze

move-folders:
  Neutze/NeutzePantry: NeutzePantry
  Neutze/NeutzePantry_Basics: NeutzePantry_Basics
  Neutze/NeutzePantry_WellFed: NeutzePantry_WellFed
  Neutze/NeutzePantry_Elixirs: NeutzePantry_Elixirs
  Neutze/NeutzePantry_Flasks: NeutzePantry_Flasks
  Neutze/NeutzePantry_Potions: NeutzePantry_Potions
  Neutze/NeutzePantry_Dynamite: NeutzePantry_Dynamite
  Neutze/NeutzePantry_Alchemy: NeutzePantry_Alchemy
  Neutze/NeutzePantry_Protection: NeutzePantry_Protection
  Neutze/NeutzePantry_Scrolls: NeutzePantry_Scrolls
  Neutze/NeutzePantry_Juju: NeutzePantry_Juju
  Neutze/NeutzePantry_Runes: NeutzePantry_Runes
  Neutze/NeutzePantry_WeaponBuffs: NeutzePantry_WeaponBuffs
  Neutze/NeutzePantry_Ammo: NeutzePantry_Ammo
  Neutze/NeutzePantry_PetFood: NeutzePantry_PetFood
  Neutze/NeutzePantry_Alerts: NeutzePantry_Alerts

ignore:
  - README.md
  - .github
  - screenshots
  - art

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
