package-as: Neutze

move-folders:
  Neutze/NeutzePantry: NeutzePantry
  Neutze/NeutzePantry_Basics: NeutzePantry_Basics
  Neutze/NeutzePantry_WellFed: NeutzePantry_WellFed
  Neutze/NeutzePantry_Elixirs: NeutzePantry_Elixirs
  Neutze/NeutzePantry_Flasks: NeutzePantry_Flasks
  Neutze/NeutzePantry_Potions: NeutzePantry_Potions
  Neutze/NeutzePantry_Dynamite: NeutzePantry_Dynamite
  Neutze/NeutzePantry_Alchemy: NeutzePantry_Alchemy
  Neutze/NeutzeCompanion: NeutzeCompanion
  Neutze/NeutzeStable: NeutzeStable

ignore:
  - README.md
  - .github
  - screenshots
  - art

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
